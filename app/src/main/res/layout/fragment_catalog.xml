<?xml version="1.0" encoding="utf-8"?>
<!-- ¿Para qué sirve?: definir la estructura visual del catálogo de productos. -->
<!-- ¿Qué hace?: muestra un buscador (SearchView) y un RecyclerView con todos los productos. -->
<!-- ¿Cuál es su función en el código?: layout que CatalogFragment infla al mostrarse. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <!-- ¿Para qué sirve?: barra de búsqueda compatible con Material Design. -->
    <!-- ¿Qué hace?: usa la versión androidx (AppCompat) del SearchView, que expone -->
    <!--             los mismos métodos que el código Java espera (OnQueryTextListener). -->
    <!-- ¿Cuál es su función en el código?: al ser androidx, su tipo coincide con el -->
    <!--             listener que CatalogFragment registra, eliminando el error de tipos. -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_margin="8dp"
        app:queryHint="Buscar productos..."
        app:iconifiedByDefault="false" />

    <!-- ¿Para qué sirve?: mostrar la lista completa de productos. -->
    <!-- ¿Qué hace?: RecyclerView vertical con todos los productos del catálogo. -->
    <!-- ¿Cuál es su función en el código?: CatalogFragment le asigna adapter y layoutManager. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCatalog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />
</LinearLayout>