<?xml version="1.0" encoding="utf-8"?>
<!-- ¿Para qué sirve?: definir la estructura visual de la gestión de productos del vendedor. -->
<!-- ¿Qué hace?: muestra un RecyclerView con sus productos y un FAB para agregar uno nuevo. -->
<!-- ¿Cuál es su función en el código?: layout que SellerProductsFragment infla al mostrarse. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Mis productos" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:text="Mantén pulsado un producto para editarlo o eliminarlo"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSellerProducts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- ¿Para qué sirve?: permitir agregar un producto nuevo. -->
    <!-- ¿Qué hace?: FAB anclado abajo a la derecha, color naranja. -->
    <!-- ¿Cuál es su función en el código?: SellerProductsFragment lo conecta para navegar al formulario. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Agregar producto"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/brand_orange"
        app:tint="@color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>