<?xml version="1.0" encoding="utf-8"?>
<!-- ¿Para qué sirve?: mostrar la supervisión de productos del sistema. -->
<!-- ¿Qué hace?: RecyclerView con todos los productos y un header de título. -->
<!-- ¿Cuál es su función en el código?: layout que AdminProductsFragment infla al mostrarse. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <TextView
        style="@style/TextAppearance.App.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Supervisión de productos" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />
</LinearLayout>