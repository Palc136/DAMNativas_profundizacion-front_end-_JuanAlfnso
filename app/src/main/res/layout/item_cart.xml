<?xml version="1.0" encoding="utf-8"?>
<!-- ¿Para qué sirve?: definir la apariencia de un ítem dentro del carrito. -->
<!-- ¿Qué hace?: muestra nombre, precio, selector de cantidad y botón eliminar. -->
<!-- ¿Cuál es su función en el código?: CartAdapter lo infla por cada producto del carrito. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:layout_marginBottom="8dp">

    <!-- ¿Para qué sirve?: mostrar los datos del producto. -->
    <!-- ¿Qué hace?: ocupa el espacio disponible, empujando el botón eliminar a la derecha. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/TextAppearance.App.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/brand_orange"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ¿Para qué sirve?: eliminar el producto del carrito. -->
    <!-- ¿Qué hace?: botón textual "Eliminar". -->
    <!-- ¿Cuál es su función en el código?: el adapter conecta el click para quitarlo de la lista. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemove"
        style="@style/Widget.App.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eliminar" />
</LinearLayout>